#
# RP64KERN_RKDRM -- Experimental RockPro64/RK3399 DRM kernel configuration.
#
# This is an integration kernel for the in-tree rk_drm scaffold. It is not
# meant to replace the working rkfb baseline yet.
#

cpu		ARM64
ident		RP64KERN_RKDRM

include		"std.arm64"
include		"std.dev"
include		"std.rockchip"

#
# DRM/KMS experiment:
# - drm2 core object model
# - fbd bridge for framebuffer-style console integration
# - rk_drm phase-1 Rockchip scaffold
# - DP kept out for now while `rk3399_power` and `fusb302` are reintegrated
#
device		fbd
device		drm2
device		rk_drm
device		rk3399_power
device		fusb302
